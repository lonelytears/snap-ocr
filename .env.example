# ============ snap-ocr 配置 ============
# 复制为 .env；所有项可被 SNAP_ 前缀环境变量覆盖

# ── OCR 服务 ──
SNAP_OCR_BASE_URL=http://127.0.0.1:8000
# 默认质量档 fast(80ms) | accurate(380ms)
SNAP_OCR_QUALITY=fast
# 识别请求超时(秒)
SNAP_OCR_TIMEOUT_S=3.0

# ── 快捷键(M2 启用) ──
# 组合键写法: <alt>+<shift>+o (pynput 语法)
SNAP_HOTKEY=<alt>+<shift>+o

# ── 界面 ──
SNAP_HISTORY_SIZE=20
SNAP_RESULT_FONT_PT=14
